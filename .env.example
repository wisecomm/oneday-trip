# Supabase — 비워 두면 앱이 로컬 데모 모드(localStorage)로 동작합니다.
# Supabase 대시보드 > Project Settings > API 에서 확인하세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 네이버 지도 — 비워 두면 SVG 폴백 지도로 렌더링됩니다.
# https://console.ncloud.com > AI·NAVER API > Application 등록 후 [인증 정보] 의 Client ID
# (Client Secret 이 아닙니다 — Secret 은 브라우저에 노출되면 안 됩니다)
#
# Web 서비스 URL 은 포트를 빼고 호스트만 등록합니다: http://localhost:5173 (X) http://localhost (O)
VITE_NAVER_MAP_CLIENT_ID=

# 인증 파라미터 이름. 신규 콘솔은 ncpKeyId(기본값), 구 콘솔은 ncpClientId.
VITE_NAVER_MAP_AUTH_PARAM=ncpKeyId
