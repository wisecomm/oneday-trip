# ── 아래 두 값을 Supabase 대시보드에서 복사해 채워 주세요 ──────────────
# Supabase 대시보드 > Project Settings > Data API (또는 API)
#   VITE_SUPABASE_URL      = Project URL          (예: https://abcdefgh.supabase.co)
#   VITE_SUPABASE_ANON_KEY = anon / public key    (eyJ... 로 시작하는 긴 문자열)
VITE_SUPABASE_URL=https://xbredajzbymvrtqxysdr.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_NvQ9eleAw4ku5ebrlhUtCg_wbXoErn-

# ── 네이버 지도 (선택) — 비워 두면 SVG 폴백 지도로 렌더링됩니다 ──────────
# NAVER Cloud Platform 콘솔 > Maps > 인증 정보의 Key ID (또는 Client ID)
VITE_NAVER_MAP_CLIENT_ID=jhf7t0hpsc


# 인증 파라미터 이름. 신규 콘솔은 ncpKeyId(기본값), 구 콘솔은 ncpClientId 입니다.
# 지도가 인증 실패로 뜨지 않으면 반대쪽 값으로 바꿔 보세요.
VITE_NAVER_MAP_AUTH_PARAM=ncpKeyId
